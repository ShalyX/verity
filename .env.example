# Required for production readiness. Never commit real values.
VERITY_ADMIN_TOKEN=replace-with-a-long-random-token
VERITY_DATABASE_URL=postgresql://user:password@host:5432/verity
VERITY_DATA_DIR=.data

# Required before claiming live 0G anchoring. Keep unset to fail closed.
ZG_STORAGE_ENDPOINT=
ZG_CHAIN_RPC_URL=
ZG_RECEIPT_CONTRACT_ADDRESS=
